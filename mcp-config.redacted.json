{
  "mcpServers": {
    "e2efi-trust": {
      "type": "http",
      "url": "http://localhost:8080/mcp",
      "tools": [
        "*"
      ]
    },
    "gitlab": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gitlab"
      ],
      "tools": [
        "*"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "<redacted>",
        "GITLAB_API_URL": "<redacted>"
      }
    }
  }
}
